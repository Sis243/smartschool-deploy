# ============================================================
# SmartSchool ERP SaaS - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# Application
NODE_ENV=development
PORT=3001

# Base de données PostgreSQL
DATABASE_URL=postgresql://smartschool:smartschool_secret_2024@localhost:5432/smartschool_db
POSTGRES_PASSWORD=smartschool_secret_2024

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_2024

# JWT (CHANGER EN PRODUCTION !)
JWT_SECRET=change_this_in_production_jwt_secret_very_long_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_in_production_refresh_secret_very_long
JWT_REFRESH_EXPIRES_IN=30d

# Domaine multi-tenant
BASE_DOMAIN=smartschool.cd

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@smartschool.cd
MAIL_PASSWORD=your_mail_password
MAIL_FROM=SmartSchool ERP <noreply@smartschool.cd>

# SMS - Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+243XXXXXXXXX

# Stockage
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001
